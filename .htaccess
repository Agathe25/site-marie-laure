# Hostinger Custom Site Configuration - Marie-Laure Bergier

DirectoryIndex index.html

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect all old WordPress tags, categories, and archive URLs to homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(tag|category|author|wp-content|wp-includes|2020|2021|2022|2023|2024|2025|2026)/.*$ /index.html [R=301,L]

# For any broken link or non-existent page, fallback smoothly to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>

ErrorDocument 404 /index.html
