# Hostinger Custom Site Configuration - Marie-Laure Bergier

DirectoryIndex index.html

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. 301 Permanent Redirect: Redirect all old WordPress links (tags, categories, old URLs) smoothly to homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ https://psychopraticienne-besancon.fr/ [R=301,L]
</IfModule>

ErrorDocument 404 /index.html
